{
	"name": "milenium",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@swc/core": "^1.11.24",
		"@types/node": "latest",
		"ts-node": "^10.9.2",
