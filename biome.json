{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},

	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},

	"linter": {
		"rules": {
			"style": {
				"useImportType": "off"
			}
		}
	}
}
